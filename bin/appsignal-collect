#!/usr/bin/env bash
# Collect an AppSignal overview (apps, open incidents, uptime monitors,
# check-ins, last deploy) into one JSON file for the memong.appsignal
# Omarchy bar plugin.
#
# Requirements: curl and jq. Auth is a personal API token, read from (first hit wins):
#   1. $APPSIGNAL_API_TOKEN
#   2. the file named by $APPSIGNAL_TOKEN_FILE
#   3. ~/.config/appsignal/api_token   (chmod 600; one line)
# Create one at https://appsignal.com/users/edit ("Personal API key").

set -uo pipefail

readonly SCHEMA_VERSION=1
readonly ENDPOINT="https://appsignal.com/graphql"
readonly METRICS_ENDPOINT="https://appsignal.com/api/v2/metrics/list"
readonly MAX_PHASE2_APPS=6

output=""
limit=5
timeout=30
metrics_timeout=20
cpu_warn=80
mem_warn=85
disk_warn=85
queue_time_warn=30000
ignore_queues=""

# v0.6: a queue whose *floor* wait (the quietest minute of the window) is still
# this long is not running anything "now" — every job in it was deliberately
# scheduled for later (deliver_later(wait:), set(wait_until:)). Such a queue is
# reported as scheduled:true and never warns. See SPEC.md "v0.6".
readonly SCHEDULED_FLOOR_MS=3600000

usage() {
  cat <<'USAGE'
Usage: appsignal-collect [options]
  -output PATH            Write the overview JSON here (default: stdout)
  -limit N                Incident rows per app, also top N slow actions (default: 5)
  -timeout SECS           GraphQL request deadline (default: 30)
  -metrics-timeout SECS   Per-request deadline for the metrics API phase (default: 20)
  -cpu-warn PCT           Host CPU % warn threshold (default: 80)
  -mem-warn PCT           Host memory % warn threshold (default: 85)
  -disk-warn PCT          Host disk % warn threshold (default: 85)
  -queue-time-warn MS     Job queue wait time warn threshold, ms (default: 30000)
  -ignore-queues LIST     Comma-separated queue names to leave out (default: none)
USAGE
}

while (($#)); do
  case "$1" in
    -output|--output) output=$2; shift 2 ;;
    -limit|--limit) limit=$2; shift 2 ;;
    -timeout|--timeout) timeout=$2; shift 2 ;;
    -metrics-timeout|--metrics-timeout) metrics_timeout=$2; shift 2 ;;
    -cpu-warn|--cpu-warn) cpu_warn=$2; shift 2 ;;
    -mem-warn|--mem-warn) mem_warn=$2; shift 2 ;;
    -disk-warn|--disk-warn) disk_warn=$2; shift 2 ;;
    -queue-time-warn|--queue-time-warn) queue_time_warn=$2; shift 2 ;;
    -ignore-queues|--ignore-queues) ignore_queues=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "appsignal-collect: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ $limit =~ ^[0-9]+$ ]] || limit=5
[[ $timeout =~ ^[0-9]+$ ]] || timeout=30
[[ $metrics_timeout =~ ^[0-9]+$ ]] || metrics_timeout=20
[[ $cpu_warn =~ ^[0-9]+$ ]] || cpu_warn=80
[[ $mem_warn =~ ^[0-9]+$ ]] || mem_warn=85
[[ $disk_warn =~ ^[0-9]+$ ]] || disk_warn=85
[[ $queue_time_warn =~ ^[0-9]+$ ]] || queue_time_warn=30000

# "mailers, low_priority" -> ["mailers","low_priority"]. Trimmed, empties
# dropped, so a trailing comma or a blank setting is harmless.
ignore_queues_json=$(jq -n --arg raw "$ignore_queues" \
  '[$raw | split(",")[] | gsub("^\\s+|\\s+$"; "") | select(. != "")]')

for tool in curl jq; do
  command -v "$tool" >/dev/null 2>&1 || { echo "appsignal-collect: $tool is required" >&2; exit 1; }
done

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# --------------------------------------------------------------- token

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
token_file=${APPSIGNAL_TOKEN_FILE:-$config_home/appsignal/api_token}
token=${APPSIGNAL_API_TOKEN:-}
if [[ -z $token && -r $token_file ]]; then
  token=$(head -n1 "$token_file" | tr -d '[:space:]')
fi

auth_help="No AppSignal token. Create a personal API key at https://appsignal.com/users/edit and save it to $token_file (chmod 600)."

# Emit a "not ready" overview and stop. Keeps any previous data out on purpose:
# a missing token is a configuration state, not a transient failure.
emit_not_ready() {
  local msg=$1
  jq -n --arg msg "$msg" --arg now "$(now_iso)" --argjson v "$SCHEMA_VERSION" \
    '{schemaVersion:$v, ready:false, stale:false, authHelpText:$msg, error:"", updatedAt:$now,
      viewer:{name:"",email:""}, organizations:[], totals:{}}' | write_out
}

write_out() {
  if [[ -n $output ]]; then
    mkdir -p "$(dirname "$output")"
    local tmp
    tmp=$(mktemp "$(dirname "$output")/.overview.XXXXXX") || exit 1
    cat > "$tmp" && mv -f "$tmp" "$output"
  else
    cat
  fi
}

if [[ -z $token ]]; then
  emit_not_ready "$auth_help"
  exit 0
fi

# --------------------------------------------------------------- query

# One request: every org, every app, and per app the open incident heads,
# uptime monitors with their alerts, check-in triggers and the last deploy.
#
# The two newest blocks — `checkIns` and `alerts` (v0.6) — are marked with
# `#opt` so a schema change on AppSignal's side can only cost us those two
# sections and not the whole overview: on a GraphQL `errors` response the
# request is retried once with every `#opt` line removed (see below). They are
# the riskiest fields here and the least essential; errors, performance,
# uptime and deploys are years-old API surface.
read -r -d '' QUERY <<'GQL' || true
query OmarchyOverview($limit: Int!) {
  viewer {
    name
    email
    organizations {
      id
      name
      slug
      apps {
        id
        name
        environment
        status
        viewerPinned
        lastPushProcessedAt
        exceptionIncidents(state: OPEN, limit: $limit, order: LAST) {
          number
          exceptionName
          exceptionMessage
          actionNames
          namespace
          count
          severity
          state
          lastOccurredAt
        }
        performanceIncidents(state: OPEN, limit: $limit, order: LAST) {
          number
          actionNames
          namespace
          mean
          count
          severity
          state
          lastOccurredAt
        }
        uptimeMonitors {
          id
          name
          url
          regions
          alerts {
            id
            state
            openedAt
            lastValue
            message
          }
        }
        checkIns {                #opt
          triggers {              #opt
            id                    #opt
            identifier            #opt
            kind                  #opt
            lastState             #opt
            lastErrorAt           #opt
            lastSuccessAt         #opt
            lastUpdateAt          #opt
          }                       #opt
        }                         #opt
        alerts {                  #opt
          id                      #opt
          state                   #opt
          openedAt                #opt
          lastValue               #opt
          peakValue               #opt
          message                 #opt
          trigger {               #opt
            name                  #opt
            metricName            #opt
          }                       #opt
        }                         #opt
        deployMarkers(limit: 1) {
          id
          createdAt
          shortRevision
          user
          liveForInWords
          exceptionCount
          exceptionRate
        }
      }
    }
  }
}
GQL

# Scratch dir. It lives under $XDG_RUNTIME_DIR (tmpfs, wiped at logout) rather
# than /tmp, and carries our own name, because the shell starts this collector
# as a child process and SIGKILLs it on `omarchy restart shell`: no trap can run
# then, so a run cut short leaves its directory behind. Named dirs let the next
# run sweep what an hour-old one left; the runtime dir keeps even that bounded.
tmp_base=${XDG_RUNTIME_DIR:-/tmp}
[[ -d $tmp_base && -w $tmp_base ]] || tmp_base=/tmp
find "$tmp_base" -maxdepth 1 -type d -name 'appsignal-collect.*' -mmin +60 \
  -exec rm -rf {} + 2>/dev/null || true
tmp=$(mktemp -d "$tmp_base/appsignal-collect.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM HUP

run_query() {
  local gql=$1 body
  body=$(jq -n --arg q "$gql" --argjson limit "$limit" '{query:$q, variables:{limit:$limit}}')
  curl -sS --max-time "$timeout" \
    -H "Content-Type: application/json" \
    -X POST "$ENDPOINT?token=$token" \
    -d "$body" -o "$tmp/resp.json" -w '%{http_code}' 2>"$tmp/curl.err" || echo 000
}

gql_failed() {
  jq -e '.errors and (.errors | length > 0)' "$tmp/resp.json" >/dev/null 2>&1
}

gql_errors() {
  jq -r '[.errors[]?.message] | join("; ")' "$tmp/resp.json" 2>/dev/null | head -c 300
}

http=$(run_query "$QUERY")

# One retry without the optional blocks. If AppSignal renames or removes a
# field inside `checkIns`/`alerts`, GraphQL rejects the *whole* document and
# the plugin would go dark on errors, performance, uptime and deploys too —
# for two sections that are empty on most apps. Retrying once with those lines
# stripped costs one request in a case that should never happen, and degrades
# to "no check-ins, no alerts" instead of "no AppSignal".
#
# A validation error arrives as HTTP 400 with an `errors` array (verified by
# renaming a field in a copy of this script), not as a 200 — so both are
# accepted here. 401/403 is a token problem and must not be retried.
degraded=""
if [[ $http == 200 || $http == 400 || $http == 422 ]] \
   && jq -e . "$tmp/resp.json" >/dev/null 2>&1 && gql_failed; then
  echo "appsignal-collect: GraphQL rejected the query ($(gql_errors)); retrying without check-ins and alerts" >&2
  http=$(run_query "$(grep -v '#opt' <<<"$QUERY")")
  if [[ $http == 200 ]] && jq -e . "$tmp/resp.json" >/dev/null 2>&1 && ! gql_failed; then
    degraded="Check-ins and alerts unavailable (AppSignal schema changed)."
  fi
fi

# ------------------------------------------------------- failure handling

# On a transient failure keep the previous overview (marked stale) so the panel
# does not blank out because of one bad request.
emit_stale() {
  local msg=$1
  if [[ -n $output && -s $output ]] && jq -e '.ready == true' "$output" >/dev/null 2>&1; then
    jq --arg msg "$msg" '.stale = true | .error = $msg' "$output" | write_out
  else
    jq -n --arg msg "$msg" --arg now "$(now_iso)" --argjson v "$SCHEMA_VERSION" \
      '{schemaVersion:$v, ready:false, stale:false, authHelpText:"", error:$msg, updatedAt:$now,
        viewer:{name:"",email:""}, organizations:[], totals:{}}' | write_out
  fi
}

if [[ $http == 000 ]]; then
  emit_stale "AppSignal unreachable: $(head -c 200 "$tmp/curl.err")"
  exit 0
fi
if [[ $http == 401 || $http == 403 ]]; then
  emit_not_ready "AppSignal rejected the token (HTTP $http). Check $token_file or \$APPSIGNAL_API_TOKEN."
  exit 0
fi
if [[ $http != 200 ]]; then
  if gql_failed; then
    emit_stale "GraphQL: $(gql_errors)"
  else
    emit_stale "AppSignal returned HTTP $http."
  fi
  exit 0
fi
if ! jq -e . "$tmp/resp.json" >/dev/null 2>&1; then
  emit_stale "AppSignal returned a non-JSON body."
  exit 0
fi
if gql_failed; then
  emit_stale "GraphQL: $(jq -r '[.errors[].message] | join("; ")' "$tmp/resp.json" | head -c 300)"
  exit 0
fi

# ------------------------------------------------------------ transform

jq --arg now "$(now_iso)" --argjson v "$SCHEMA_VERSION" --arg degraded "$degraded" '
  def site_url($org; $app): "https://appsignal.com/\($org)/sites/\($app)";
  def open_alerts: [ (.alerts // [])[] | select(.state == "OPEN" or .state == "WARMUP") ];
  def sev: (.severity // "") | ascii_downcase;

  .data.viewer as $viewer
  | {
      schemaVersion: $v,
      ready: true,
      stale: false,
      authHelpText: "",
      error: $degraded,
      updatedAt: $now,
      viewer: { name: ($viewer.name // ""), email: ($viewer.email // "") },
      organizations: [
        ($viewer.organizations // [])[]
        | . as $org
        | {
            id: .id, name: .name, slug: .slug,
            apps: [
              (.apps // [])[]
              | . as $app
              | (site_url($org.slug; $app.id)) as $base
              | {
                  id: .id,
                  name: .name,
                  environment: (.environment // ""),
                  status: (.status // ""),
                  pinned: (.viewerPinned == true),
                  lastPushProcessedAt: (.lastPushProcessedAt // ""),
                  url: $base,
                  errorsUrl: "\($base)/exceptions",
                  perfUrl: "\($base)/performance",
                  uptimeUrl: "\($base)/uptime-monitoring",
                  checkInsUrl: "\($base)/check-ins",
                  deploysUrl: "\($base)/deploys",
                  errors: [
                    (.exceptionIncidents // [])[]
                    | {
                        number, kind: "error",
                        title: (.exceptionName // "Error"),
                        message: (.exceptionMessage // ""),
                        action: ((.actionNames // []) | join(", ")),
                        namespace: (.namespace // ""),
                        count: (.count // 0),
                        severity: sev,
                        lastOccurredAt: (.lastOccurredAt // ""),
                        url: "\($base)/exceptions/incidents/\(.number)"
                      }
                  ],
                  perf: [
                    (.performanceIncidents // [])[]
                    | {
                        number, kind: "perf",
                        title: ((.actionNames // []) | join(", ")),
                        message: "",
                        action: ((.actionNames // []) | join(", ")),
                        namespace: (.namespace // ""),
                        count: (.count // 0),
                        mean: (.mean // 0),
                        severity: sev,
                        lastOccurredAt: (.lastOccurredAt // ""),
                        url: "\($base)/performance/incidents/\(.number)"
                      }
                  ],
                  monitors: [
                    (.uptimeMonitors // [])[]
                    | (open_alerts) as $open
                    | {
                        id, name, url,
                        regions: (.regions // []),
                        down: (($open | length) > 0),
                        openAlerts: ($open | length),
                        openedAt: (($open | map(.openedAt // "") | sort | first) // ""),
                        message: (($open | map(.message // "") | map(select(. != "")) | first) // ""),
                        panelUrl: "\($base)/uptime-monitoring/\(.id)"
                      }
                  ],
                  checkIns: [
                    ((.checkIns // {}).triggers // [])[]
                    | {
                        id, identifier,
                        kind: (.kind // ""),
                        lastState: (.lastState // ""),
                        failing: ((.lastState // "") | IN("MISSED","LATE","UNEXPECTED")),
                        lastErrorAt: (.lastErrorAt // ""),
                        lastSuccessAt: (.lastSuccessAt // ""),
                        lastUpdateAt: (.lastUpdateAt // ""),
                        url: "\($base)/check-ins/\(.id)"
                      }
                  ],
                  # v0.6: only OPEN/WARMUP triggers (the alerts actually
                  # demanding attention). App.alerts takes no state/limit
                  # argument (unlike exceptionIncidents), so the filter has
                  # to happen here; harmless today since every app on this
                  # tenant has 0 triggers. No confirmed per-trigger URL
                  # exists without an interactive login (same situation as
                  # host-metrics in v0.5), so it opens app.url like a host row.
                  alerts: [
                    (.alerts // [])[]
                    | select(.state == "OPEN" or .state == "WARMUP")
                    | {
                        id, state: (.state // ""),
                        triggerName: ((.trigger.name) // ""),
                        metric: ((.trigger.metricName) // ""),
                        message: (.message // ""),
                        lastValue: (.lastValue // 0),
                        peakValue: (.peakValue // 0),
                        openedAt: (.openedAt // ""),
                        url: $base
                      }
                  ],
                  lastDeploy: (
                    ((.deployMarkers // []) | first) as $d
                    | if $d == null then null else {
                        id: $d.id,
                        createdAt: ($d.createdAt // ""),
                        shortRevision: ($d.shortRevision // ""),
                        user: ($d.user // ""),
                        liveForInWords: ($d.liveForInWords // ""),
                        exceptionCount: ($d.exceptionCount // 0),
                        exceptionRate: ($d.exceptionRate // 0)
                      } end
                  )
                }
              | .totals = {
                  errors: (.errors | length),
                  perf: (.perf | length),
                  monitors: (.monitors | length),
                  monitorsDown: ([.monitors[] | select(.down)] | length),
                  checkIns: (.checkIns | length),
                  checkInsFailing: ([.checkIns[] | select(.failing)] | length),
                  alertsOpen: (.alerts | length)
                }
            ]
          }
      ]
    }
  | .totals = (
      [.organizations[].apps[].totals]
      | {
          apps: length,
          errors: (map(.errors) | add // 0),
          perf: (map(.perf) | add // 0),
          monitors: (map(.monitors) | add // 0),
          monitorsDown: (map(.monitorsDown) | add // 0),
          checkIns: (map(.checkIns) | add // 0),
          checkInsFailing: (map(.checkInsFailing) | add // 0),
          alertsOpen: (map(.alertsOpen) | add // 0)
        }
    )
' "$tmp/resp.json" > "$tmp/phase1.json"

# --------------------------------------------------------- phase 2: metrics
#
# Second pass, read-only, against /api/v2/metrics/list: per-hour health
# (throughput, error rate, mean duration) and 24h slowest actions, but only
# for apps pinned in AppSignal (viewerPinned) — or, if none is pinned, the
# first MAX_PHASE2_APPS apps overall. One failing app never blocks the rest
# of the overview: it just keeps health:null / slowActions:[]. See SPEC.md
# "v0.4" for the exact queries and why each field/tag/aggregation was chosen.

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
hours_ago_utc() { date -u -d "-$1 hour" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-"$1"H +%Y-%m-%dT%H:%M:%SZ; }
minutes_ago_utc() { date -u -d "-$1 minute" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-"$1"M +%Y-%m-%dT%H:%M:%SZ; }

mapfile -t all_app_ids < <(jq -r '(.data.viewer.organizations // [])[] | (.apps // [])[] | .id' "$tmp/resp.json")
mapfile -t pinned_app_ids < <(jq -r '(.data.viewer.organizations // [])[] | (.apps // [])[] | select(.viewerPinned == true) | .id' "$tmp/resp.json")

phase2_ids=()
if ((${#pinned_app_ids[@]} > 0)); then
  phase2_ids=("${pinned_app_ids[@]}")
else
  phase2_ids=("${all_app_ids[@]:0:$MAX_PHASE2_APPS}")
fi

fetch_phase2_app() {
  local app_id=$1 health_out=$2 slow_out=$3 hosts_out=$4 jobs_out=$5
  local from1 to1 from24 to24 from15 to15 health_body slow_body hc sc

  to1=$(now_utc)
  from1=$(hours_ago_utc 1)
  to24=$to1
  from24=$(hours_ago_utc 24)
  to15=$to1
  from15=$(minutes_ago_utc 15)

  health_body=$(jq -n --arg site "$app_id" --arg from "$from1" --arg to "$to1" '
    {site_id:$site, from:$from, to:$to, resolution:"MINUTELY",
     select:[
       {id:"throughput", name:"site_throughput", tags:{}, field:"COUNTER", aggregation:"SUM"},
       {id:"errorRate", name:"error_rate", tags:{namespace:"web"}, field:"GAUGE", aggregation:"AVERAGE"},
       {id:"meanMs", name:"transaction_duration", tags:{namespace:"web"}, field:"MEAN", aggregation:"AVERAGE"}
     ],
     group_by:["Name"], limit:10}')

  # v0.4.1: ask for a deep limit (>=200) so the impact ranking below (totalMs =
  # meanMs * count) is computed over the real 24h action set, not just a
  # top-100-by-mean that can hide high-volume, high-impact actions.
  slow_body=$(jq -n --arg site "$app_id" --arg from "$from24" --arg to "$to24" '
    {site_id:$site, from:$from, to:$to, resolution:"HOURLY",
     select:[
       {id:"meanMs", name:"transaction_duration", tags:{namespace:"*", action:"*"}, field:"MEAN", aggregation:"AVERAGE"},
       {id:"count", name:"transaction_duration", tags:{namespace:"*", action:"*"}, field:"COUNT", aggregation:"SUM"}
     ],
     group_by:[{Tag:"action"}, {Tag:"namespace"}], limit:200}')

  hc=$(curl -sS --max-time "$metrics_timeout" \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    -X POST "$METRICS_ENDPOINT" -d "$health_body" -o "$health_out.raw" -w '%{http_code}' 2>/dev/null) || hc=000
  sc=$(curl -sS --max-time "$metrics_timeout" \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    -X POST "$METRICS_ENDPOINT" -d "$slow_body" -o "$slow_out.raw" -w '%{http_code}' 2>/dev/null) || sc=000

  if [[ $hc == 200 ]] && jq -e '.rows and (.error | not)' "$health_out.raw" >/dev/null 2>&1; then
    jq '
      ([.rows[].data] | add // {}) as $d
      | if ($d.throughput == null and $d.errorRate == null and $d.meanMs == null) then null
        else { throughput: $d.throughput, errorRate: $d.errorRate, meanMs: $d.meanMs, window: "1h" }
        end
    ' "$health_out.raw" > "$health_out" 2>/dev/null || echo null > "$health_out"
  else
    echo null > "$health_out"
  fi

  # v0.4.1: rank by impact (totalMs = meanMs * count), not by mean alone — a
  # 59s job that ran once and a 5ms action that ran 100k times both looked
  # "slow" under the old mean-only sort, but only one of them matters. Split
  # into slowWeb (namespace "web") and slowBackground (everything else, e.g.
  # background jobs), each independently ranked and capped at N = floor
  # (incidentsPerApp / 2) + 1 rows (default incidentsPerApp 5 -> 3 rows/group).
  if [[ $sc == 200 ]] && jq -e '.rows and (.error | not)' "$slow_out.raw" >/dev/null 2>&1; then
    jq --argjson limit "$limit" '
      ( ($limit / 2 | floor) + 1 ) as $n
      | [ (.rows // [])[]
          | select(.data.meanMs != null)
          | { action: (.group.action // ""), namespace: (.group.namespace // ""),
              meanMs: (.data.meanMs // 0), count: (.data.count // 0),
              totalMs: ((.data.meanMs // 0) * (.data.count // 0)) }
        ] as $all
      | ($all | map(select(.namespace == "web")) | sort_by(-.totalMs) | .[0:$n]) as $web
      | ($all | map(select(.namespace != "web")) | sort_by(-.totalMs) | .[0:$n]) as $bg
      | { slowWeb: $web, slowBackground: $bg, slowActions: ($web + $bg) }
    ' "$slow_out.raw" > "$slow_out" 2>/dev/null || echo '{"slowWeb":[],"slowBackground":[],"slowActions":[]}' > "$slow_out"
  else
    echo '{"slowWeb":[],"slowBackground":[],"slowActions":[]}' > "$slow_out"
  fi

  # ------------------------------------------------------------- v0.5: hosts
  #
  # Two POSTs (see SPEC.md "v0.5" for why not one): cpu/memory/swap/load_avg
  # share the "state" tag dimension; disk_usage uses "mountpoint" instead, and
  # mixing both dimensions in one group_by produces a confusing cross-product.
  # `cpu`'s "total_usage" state is already a direct, verified percentage (it
  # matches user+system+nice+iowait+steal); `memory`/`swap`'s "total" state is
  # unpopulated (always 0) on both hosts checked, so memPct/swapPct stay null
  # rather than divide by a zero total; the absolute "used" value in MB is kept
  # as memUsedMb/swapUsedMb so the panel can still show real memory.
  local hm_body disk_body hmc dc

  hm_body=$(jq -n --arg site "$app_id" --arg from "$from15" --arg to "$to15" '
    {site_id:$site, from:$from, to:$to, resolution:"MINUTELY",
     select:[
       {id:"cpu", name:"cpu", tags:{state:"*", hostname:"*"}, field:"GAUGE", aggregation:"AVERAGE"},
       {id:"memUsed", name:"memory", tags:{state:"used", hostname:"*"}, field:"GAUGE", aggregation:"AVERAGE"},
       {id:"memTotal", name:"memory", tags:{state:"total", hostname:"*"}, field:"GAUGE", aggregation:"AVERAGE"},
       {id:"swap", name:"swap", tags:{state:"*", hostname:"*"}, field:"GAUGE", aggregation:"AVERAGE"},
       {id:"load1", name:"load_avg", tags:{hostname:"*"}, field:"GAUGE", aggregation:"AVERAGE"}
     ],
     group_by:[{Tag:"hostname"}, {Tag:"state"}], limit:100}')

  disk_body=$(jq -n --arg site "$app_id" --arg from "$from15" --arg to "$to15" '
    {site_id:$site, from:$from, to:$to, resolution:"MINUTELY",
     select:[{id:"disk", name:"disk_usage", tags:{mountpoint:"*", hostname:"*"}, field:"GAUGE", aggregation:"AVERAGE"}],
     group_by:[{Tag:"hostname"}, {Tag:"mountpoint"}], limit:100}')

  hmc=$(curl -sS --max-time "$metrics_timeout" \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    -X POST "$METRICS_ENDPOINT" -d "$hm_body" -o "$hosts_out.hm.raw" -w '%{http_code}' 2>/dev/null) || hmc=000
  dc=$(curl -sS --max-time "$metrics_timeout" \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    -X POST "$METRICS_ENDPOINT" -d "$disk_body" -o "$hosts_out.disk.raw" -w '%{http_code}' 2>/dev/null) || dc=000

  if [[ $hmc == 200 && $dc == 200 ]] \
     && jq -e '.rows and (.error | not)' "$hosts_out.hm.raw" >/dev/null 2>&1 \
     && jq -e '.rows and (.error | not)' "$hosts_out.disk.raw" >/dev/null 2>&1; then
    jq -n --slurpfile hm "$hosts_out.hm.raw" --slurpfile disk "$hosts_out.disk.raw" \
      --argjson cpuWarn "$cpu_warn" --argjson memWarn "$mem_warn" --argjson diskWarn "$disk_warn" '
      # Strip a trailing "-<container id>" from a hostname when what is left
      # looks like an IP or a legible name (both real hosts are
      # "<ip>-<container id>"): "178.156.134.200-94c077fa010a" ->
      # "178.156.134.200".
      def shortName:
        . as $h
        | if ($h | test("^.+-[^-]+$")) then
            ($h | sub("-[^-]+$"; "")) as $prefix
            | if ($prefix | test("^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"))
                or ($prefix | test("^[A-Za-z][A-Za-z0-9_.]*$"))
              then $prefix else $h end
          else $h end;

      ($hm[0].rows // []) as $hmRows
      | ($disk[0].rows // []) as $diskRows
      | ( ($hmRows | map(.group.hostname)) + ($diskRows | map(.group.hostname)) | unique ) as $hostnames
      | [ $hostnames[] as $host
          | ($hmRows | map(select(.group.hostname == $host))) as $rows
          | ($diskRows | map(select(.group.hostname == $host))) as $dRows
          | (reduce $rows[] as $r ({};
              . + (if $r.data.memUsed != null then {memUsedMb: $r.data.memUsed} else {} end)
                + (if ($r.data.memTotal != null and $r.group.state == "total") then {memTotalMb: $r.data.memTotal} else {} end)
                + (if ($r.data.cpu != null and $r.group.state == "total_usage") then {cpuPct: $r.data.cpu} else {} end)
                + (if ($r.data.swap != null and $r.group.state == "used") then {swapUsedMb: $r.data.swap} else {} end)
                + (if ($r.data.swap != null and $r.group.state == "total") then {swapTotalMb: $r.data.swap} else {} end)
                + (if $r.data.load1 != null then {load1: $r.data.load1} else {} end)
            )) as $agg
          | ($dRows | map({mountpoint: .group.mountpoint, pct: .data.disk}) | sort_by(-.pct) | (.[0] // null)) as $worstDisk
          | (($agg.memTotalMb // 0) > 0) as $hasMemTotal
          | (($agg.swapTotalMb // 0) > 0) as $hasSwapTotal
          | {
              hostname: $host,
              shortName: ($host | shortName),
              cpuPct: ($agg.cpuPct // null),
              memPct: (if $hasMemTotal then (($agg.memUsedMb / $agg.memTotalMb) * 100) else null end),
              # Absolute memory in MB, the only memory figure real hosts publish
              # ("total" is always 0, so memPct is null there): the panel falls
              # back to "MEM 1.1 GB" instead of showing nothing.
              memUsedMb: ($agg.memUsedMb // null),
              load1: ($agg.load1 // null),
              diskPct: ($worstDisk.pct // null),
              diskMount: ($worstDisk.mountpoint // null),
              swapPct: (if $hasSwapTotal then (($agg.swapUsedMb // 0) / $agg.swapTotalMb * 100) else null end),
              swapUsedMb: ($agg.swapUsedMb // null)
            }
          | . + { warn: (
              ((.cpuPct // 0) >= $cpuWarn)
              or ((.diskPct // 0) >= $diskWarn)
              or (.memPct != null and .memPct >= $memWarn)
            ) }
        ]
    ' > "$hosts_out" 2>/dev/null || echo '[]' > "$hosts_out"
  else
    echo '[]' > "$hosts_out"
  fi

  # ------------------------------------------------------------- v0.6: jobs
  #
  # One POST for every background queue (ActiveJob): job_count split into two
  # selectors with a *fixed* (non-wildcard) "status" tag each — "processed"
  # and "failed" — plus two views of queue_time, all grouped by "queue" alone.
  # A fixed tag on a selector does not need to appear in group_by (only a "*"
  # wildcard does), so this single request works even though
  # active_job_queue_time has no "status" tag at all.
  #
  # Why MEAN aggregated with MIN and not with AVERAGE (v0.6 fix): a mean over
  # the whole window mixes jobs that wanted to run *now* with jobs that were
  # deliberately scheduled for later (deliver_later(wait:)), and one weekly
  # mail turns the number into days. Real numbers, SkillsNT prod `mailers`,
  # same hour: MEAN/AVERAGE 209,828,950 ms (58 h) vs MEAN/MIN 41 ms — the
  # second is the latency a job actually pays when it is ready to run. P50
  # would have been the textbook answer but AppSignal does not store it for
  # this metric ("Invalid field: 'p_50'"); only MEAN, COUNT, P90 and P95 are
  # valid fields, and P90/P95 are computed *inside* each bucket, so they carry
  # exactly the same scheduled-job contamination (mailers P95 209,828,951 ms).
  # queueTimeHighMs (P95 over the window) is kept as the contrasting "worst
  # view" for the agent prompt. Note the API drops duplicate selectors on the
  # same metric+field, so each of these four must use a distinct field.
  # See SPEC.md "v0.6" for the full distribution table.
  local jobs_body jc

  jobs_body=$(jq -n --arg site "$app_id" --arg from "$from1" --arg to "$to1" '
    {site_id:$site, from:$from, to:$to, resolution:"MINUTELY",
     select:[
       {id:"processed", name:"active_job_queue_job_count", tags:{queue:"*", status:"processed"}, field:"COUNTER", aggregation:"SUM"},
       {id:"failed", name:"active_job_queue_job_count", tags:{queue:"*", status:"failed"}, field:"COUNTER", aggregation:"SUM"},
       {id:"queueTimeMs", name:"active_job_queue_time", tags:{queue:"*"}, field:"MEAN", aggregation:"MIN"},
       {id:"queueTimeHighMs", name:"active_job_queue_time", tags:{queue:"*"}, field:"P95", aggregation:"AVERAGE"}
     ],
     group_by:[{Tag:"queue"}], limit:100}')

  jc=$(curl -sS --max-time "$metrics_timeout" \
    -H "Authorization: Bearer $token" -H "Content-Type: application/json" \
    -X POST "$METRICS_ENDPOINT" -d "$jobs_body" -o "$jobs_out.raw" -w '%{http_code}' 2>/dev/null) || jc=000

  if [[ $jc == 200 ]] && jq -e '.rows and (.error | not)' "$jobs_out.raw" >/dev/null 2>&1; then
    jq --argjson limit "$limit" --argjson queueTimeWarn "$queue_time_warn" \
       --argjson scheduledFloor "$SCHEDULED_FLOOR_MS" --argjson ignore "$ignore_queues_json" '
      [ (.rows // [])[]
        | { name: (.group.queue // ""),
            processed: (.data.processed // 0),
            failed: (.data.failed // 0),
            queueTimeMs: (.data.queueTimeMs // null),
            queueTimeHighMs: (.data.queueTimeHighMs // null) }
        | select((.name | IN($ignore[])) | not)
        # Even the floor is hours: nothing in this queue is waiting to run now,
        # it is a schedule. Show it as such instead of as a red backlog.
        | . + { scheduled: (.queueTimeMs != null and .queueTimeMs >= $scheduledFloor) }
        | . + { warn: (
            (.failed > 0)
            or ((.scheduled | not) and .queueTimeMs != null and .queueTimeMs >= $queueTimeWarn)
          ) }
      ]
      # Anything warning first, a scheduled queue last, and the rest by
      # throughput. Sorting healthy queues by wait (as v0.6 first did) ranks
      # them by noise now that the waits are all tens of milliseconds, and it
      # pushed the busiest queue of the app off the top-N list; whatever is
      # actually wrong floats up through .warn anyway.
      | sort_by([ (if .warn then 0 else 1 end),
                  (if .scheduled then 1 else 0 end),
                  -(.processed // 0),
                  -(.queueTimeMs // 0) ])
      | .[0:$limit]
    ' "$jobs_out.raw" > "$jobs_out" 2>/dev/null || echo '[]' > "$jobs_out"
  else
    echo '[]' > "$jobs_out"
  fi
}

if ((${#phase2_ids[@]} > 0)); then
  for app_id in "${phase2_ids[@]}"; do
    fetch_phase2_app "$app_id" "$tmp/health_$app_id.json" "$tmp/slow_$app_id.json" "$tmp/hosts_$app_id.json" "$tmp/jobs_$app_id.json" &
  done
  wait
fi

{
  echo '{}'
  for app_id in "${phase2_ids[@]}"; do
    jq -n --arg id "$app_id" \
      --slurpfile h <(cat "$tmp/health_$app_id.json" 2>/dev/null || echo null) \
      --slurpfile s <(cat "$tmp/slow_$app_id.json" 2>/dev/null || echo '{"slowWeb":[],"slowBackground":[],"slowActions":[]}') \
      --slurpfile hosts <(cat "$tmp/hosts_$app_id.json" 2>/dev/null || echo '[]') \
      --slurpfile jobs <(cat "$tmp/jobs_$app_id.json" 2>/dev/null || echo '[]') \
      '{($id): {health: ($h[0] // null), slowWeb: ($s[0].slowWeb // []),
                slowBackground: ($s[0].slowBackground // []), slowActions: ($s[0].slowActions // []),
                hosts: ($hosts[0] // []), queues: ($jobs[0] // [])}}'
  done
} | jq -s 'add' > "$tmp/phase2.json"

# v0.5/v0.6: merge hosts and queues, then recompute totals.hostsWarn and
# totals.queuesWarn (per app and global) now that this data exists —
# phase1's .totals was built before it landed.
jq --slurpfile p2 "$tmp/phase2.json" '
  ($p2[0] // {}) as $p2
  | .organizations = [
      .organizations[]
      | .apps = [
          .apps[]
          | . + { health: ($p2[.id].health // null),
                  slowWeb: ($p2[.id].slowWeb // []),
                  slowBackground: ($p2[.id].slowBackground // []),
                  slowActions: ($p2[.id].slowActions // []),
                  hosts: ($p2[.id].hosts // []),
                  queues: ($p2[.id].queues // []) }
          | .totals.hostsWarn = ([.hosts[] | select(.warn == true)] | length)
          | .totals.queuesWarn = ([.queues[] | select(.warn == true)] | length)
        ]
    ]
  | .totals.hostsWarn = ([.organizations[].apps[].totals.hostsWarn] | add // 0)
  | .totals.queuesWarn = ([.organizations[].apps[].totals.queuesWarn] | add // 0)
' "$tmp/phase1.json" | write_out
